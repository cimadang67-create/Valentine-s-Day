import tkinter as tk
import math
import threading
import time
import sys

# Optional sound (Windows only)
if sys.platform == "win32":
    import winsound

class ValentineApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Happy Valentine's Day ❤️")
        self.root.geometry("600x650")
        self.root.configure(bg="#ffccd5")
        self.root.resizable(False, False)

        self.nama = ""

        # Input Nama
        self.entry_label = tk.Label(root, text="zahro sayaaang 💌",
                                    font=("Helvetica", 12, "bold"),
                                    bg="#ffccd5", fg="#800f2f")
        self.entry_label.pack(pady=5)

        self.name_entry = tk.Entry(root, font=("Helvetica", 12), justify="center")
        self.name_entry.pack(pady=5)

        self.start_button = tk.Button(root, text="Mulai ❤️",
                                      font=("Helvetica", 12, "bold"),
                                      bg="#ff4d6d", fg="white",
                                      command=self.start_app)
        self.start_button.pack(pady=10)

        self.canvas = tk.Canvas(root, width=600, height=400,
                                bg="#ffccd5", highlightthickness=0)
        self.canvas.pack()

        self.label = tk.Label(root, text="", font=("Helvetica", 14, "italic"),
                              bg="#ffccd5", fg="#800f2f", wraplength=500)
        self.label.pack(pady=10)

        self.scale = 1

    def draw_heart(self, scale):
        self.canvas.delete("all")
        points = []
        for t in range(0, 360):
            t = math.radians(t)
            x = 16 * math.sin(t)**3
            y = (13 * math.cos(t)
                 - 5 * math.cos(2*t)
                 - 2 * math.cos(3*t)
                 - math.cos(4*t))
            x *= scale * 10
            y *= scale * 10
            points.append(300 + x)
            points.append(200 - y)
        self.canvas.create_polygon(points, fill="#ff1e56", outline="#c9184a", width=2)

    def animate_heart(self):
        self.scale += 0.02
        if self.scale > 1.2:
            self.scale = 1
        self.draw_heart(self.scale)
        self.root.after(50, self.animate_heart)

    def type_writer(self, text):
        self.label.config(text="")
        for i in range(len(text)+1):
            temp = text[:i]
            self.label.config(text=temp)
            time.sleep(0.05)

    def start_app(self):
        self.nama = self.name_entry.get()
        if self.nama.strip() == "":
            self.nama = " sayaaang❤️"

        message = (
            f"Happy Valentine’s Day, {self.nama} 💕\n\n"
            f"Terima kasih sudah hadir di hidupku, {self.nama}.\n"
            "Aku bersyukur banget bisa kenal kamu.\n"
            "Semoga hari ini penuh cinta, tawa, dan kebahagiaan.\n\n"
            f"Aku selalu ada buat kamu, {self.nama} ❤️"
        )

        self.animate_heart()

        threading.Thread(target=self.type_writer,
                         args=(message,), daemon=True).start()

        if sys.platform == "win32":
            winsound.Beep(1000, 300)
            winsound.Beep(1200, 300)


if __name__ == "__main__":
    root = tk.Tk()
    app = ValentineApp(root)
    root.mainloop()
